DATABASE_URL="postgresql://itsm_user:itsm_password@localhost:5432/itsm?schema=public"
JWT_SECRET="dev-only-secret-change-me-0123456789"   # >=16 chars; the server refuses placeholders in production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=14
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"                 # exact browser origin; used for CORS, sockets and CSRF checks
APP_URL="http://localhost:5173"                       # used in links inside emails / webhooks
TRUST_PROXY=0                                         # set to the number of reverse proxies in front of the API
ALLOW_REGISTRATION=true

# AI (optional). Blank key = offline rules for every feature.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"
ANTHROPIC_BASE_URL="https://api.anthropic.com"        # point at a gateway/proxy if your org requires one
AI_TIMEOUT_MS=20000
AI_REDACT_PII=true                                    # strip emails, phone and card numbers before text leaves the server

# Files & email
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=10
SMTP_URL=""                                           # e.g. smtps://user:pass@smtp.example.com
MAIL_FROM="Northbeam ITSM <no-reply@example.com>"
INBOUND_EMAIL_SECRET=""                               # enables POST /api/inbound/email

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
LOG_LEVEL=info
